{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Chrome",
			"request": "launch",
			"type": "chrome",
			"url": "http://localhost:5173/blacklab-frontend/",
			"webRoot": "${workspaceFolder}/src/frontend"
		},
		{
			"type": "editor-browser",
			"request": "launch",
			"name": "Launch in integrated browser",
			"url": "http://localhost:5173/blacklab-frontend/",
			"webRoot": "${workspaceFolder}/src/frontend"
		},
		{
			"type": "editor-browser",
			"request": "attach",
			"name": "Attach to integrated browser",
			"webRoot": "${workspaceFolder}/src/frontend"
		}
	]
}
