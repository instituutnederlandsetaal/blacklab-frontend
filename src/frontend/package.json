{
	"name": "blacklab-frontend",
	"version": "5.0.0-SNAPSHOT",
	"private": true,
	"description": "BlackLab Frontend javascript code",
	"license": "Apache-2.0",
	"author": "INT",
	"type": "module",
	"packageManager": "npm@12.0.2",
	"scripts": {
		"test": "npm run test:unit:coverage && npm run test:storybook && npm run test:customization-api",
		"test:customization-api": "npm run build:customization-api && tsc -p tooling/customization-api/tsconfig.json && node tooling/test-customization-api-package.js",
		"test:unit:coverage": "vitest --run --project unit --coverage",
		"test:storybook": "vitest --run --project storybook",
		"test:url-sync:smoke": "node tooling/url-sync-smoke.js",
		"test:watch": "vitest --watch",
		"lint": "node tooling/lint.js",
		"build": "vite build && node tooling/copy-bootstrap-assets.js && npm run build:customization-api",
		"build:blfschema": "node tooling/compile-schema.js",
		"build:customization-api": "node tooling/build-customization-api.js && node tooling/write-customization-api-package.js",
		"start": "vite --host 0.0.0.0 --port 5173",
		"node": "node",
		"format": "oxfmt --config tooling/oxfmt.config.ts ./src/ ./test/",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@types/jquery": "^4.0.0",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vue/compiler-sfc": "^3.5.31",
		"@vue/devtools-api": "^8.1.1",
		"@vue/tsconfig": "^0.9.1",
		"@vueuse/core": "^14.3.0",
		"axios": "^0.21.2",
		"bootstrap": "^3.4.1",
		"clone-deep": "^4.0.1",
		"common-tags": "^1.8.0",
		"dts-bundle-generator": "^9.5.1",
		"file-saver": "^1.3.8",
		"floating-vue": "^5.2.2",
		"highcharts": "^9.0.0",
		"highcharts-vue": "^2.0.1",
		"jquery": "^4.0.0",
		"lucene-query-parser": "^1.2.0",
		"memoize-decorator": "^1.0.2",
		"monaco-editor": "^0.47.0",
		"monaco-yaml": "^5.5.1",
		"oidc-client-ts": "^2.4.0",
		"popper.js": "^1.15.0",
		"rxjs": "^7.8.1",
		"sass": "^1.92.1",
		"strip-json-comments": "^5.0.1",
		"ts-deepmerge": "^7.0.0",
		"typescript": "^6.0.3",
		"urijs": "^1.19.7",
		"vite": "^8.0.3",
		"vue": "^3.5.34",
		"vue-3-slider-component": "^1.0.2",
		"vue-i18n": "^9.14.5",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "10.3.6",
		"@storybook/addon-docs": "10.3.6",
		"@storybook/addon-vitest": "10.3.6",
		"@storybook/vue3-vite": "10.3.6",
		"@types/bootstrap": "^3.4.0",
		"@types/common-tags": "^1.8.0",
		"@types/file-saver": "^1.3.1",
		"@types/node": "^25.6.0",
		"@types/urijs": "^1.19.26",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"@vue/test-utils": "^2.4.6",
		"jsdom": "^29.0.2",
		"knip": "^6.32.0",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"playwright": "^1.61.1",
		"storybook": "10.3.6",
		"ts-json-schema-generator": "^2.9.0",
		"vite-plugin-checker": "^0.12.0",
		"vitest": "4.1.10",
		"vue-tsc": "^3.2.8"
	},
	"allowScripts": {
		"esbuild@0.27.7": true,
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true
	}
}
