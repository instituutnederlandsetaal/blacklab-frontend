/**
 * Contains the core types for the UI state in the form system.
 * I.e. the node graph that defines the order of the containers and fields that are shown in the form,
 * and their mapping to internal state and controllers.
 */

import { type AllowedComponentProps, type Component, type ComponentCustomProps, type VNodeProps } from 'vue';

import type { AnyFieldController } from '@/features/form/model/builder/form-shape-builder';
import type { FieldController } from '@/features/form/model/types/form-controllers';

export type FormNodeKind = 'container' | 'form' | 'field' | 'view';
export type ContainerPresentation = 'list' | 'tabs' | 'small-tabs' | (string & {}); // open-ended but with some fixed types we support internally.
export type FieldPresentation = 'default' | 'large' | 'simple' | (string & {}); // open-ended but with some fixed types we support internally.
export type QueryCombineMode = 'allOf' | 'anyOf' | 'sequence';

//==========================================================================================================================

type RequiredKeys<T> = {
	[K in keyof T]-?: {} extends Pick<T, K> ? never : K;
}[keyof T];

type SharedKeys<A, B> = Extract<keyof A, keyof B>;

type MissingRequiredKeys<Node extends object, Props extends object> = {
	[K in RequiredKeys<Props>]: K extends keyof Node ? ({} extends Pick<Node, K> ? K : Node[K] extends Props[K] ? never : K) : K;
}[RequiredKeys<Props>];

type IncompatibleSharedKeys<Node extends object, Props extends object> = {
	[K in SharedKeys<Node, Props>]: Node[K] extends Props[K] ? never : K;
}[SharedKeys<Node, Props>];

export type AnyVueComponent = new (...args: any) => { $props: any };

type VueBuiltinPropKeys = keyof (VNodeProps & AllowedComponentProps & ComponentCustomProps);

type PublicPropsOf<C extends AnyVueComponent> = Omit<InstanceType<C>['$props'], VueBuiltinPropKeys>;

type BindableComponent<Node extends object, C extends AnyVueComponent> =
	MissingRequiredKeys<Node, PublicPropsOf<C>> extends never ? (IncompatibleSharedKeys<Node, PublicPropsOf<C>> extends never ? C : never) : never;

// =====================================================================================================================

/** The base for all form nodes */
export type FormNodeBase = {
	id: string;
	title?: string;
	titleKey?: string;
	class?: string;
};

export type ContainerNodeBase = FormNodeBase & {
	kind: 'container';
	/** Defaults to list if unset */
	variant?: ContainerPresentation;
	hideTitle?: string;
	children: FormNode[];
	/** Defaults to 'allOf' if unset */
	combine?: QueryCombineMode;
};
export type ContainerComponentProps = ContainerNodeBase & { htmlId: string };
export type ContainerComponent = Component<ContainerComponentProps>;
export type NewContainerNodeConfig = Omit<ContainerNodeBase, 'id' | 'children' | 'kind'>;

// need this to prevent recursive types
// because containernode has children, which can have containernode
// and typescript doesn't seem to like that. Especially when generics are involved.
// type SimpleContainerNode = ContainerNodeBase & {
// 	component: Component<any>;
// };

// type ContainerExtraFields<Extra extends object> = Omit<Extra, keyof ContainerNodeBase | 'component'>;

// export type ContainerNode<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = ContainerNodeBase &
// 	ContainerExtraFields<Extra> & {
// 		component: BindableComponent<ContainerNodeBase & ContainerExtraFields<Extra>, C>;
// 	};

// export type ContainerComponentProps = ContainerNodeBase & { htmlId: string };

/** When submitting a form, the form can indicate some initial result displaying settings. */
export type ResultPreset = {
	viewedResults?: string;
	groupBy?: string[];
	sort?: string | null;
	groupDisplayMode?: string | null;
};

type ComponentlessFormBoundaryNode = Omit<ContainerNodeBase, 'component' | 'kind' | 'combine'> & {
	kind: 'form';
	resultPreset?: Partial<ResultPreset>;
};

type SimpleFormBoundaryNode = ComponentlessFormBoundaryNode & {
	component: AnyVueComponent;
};

type FormBoundaryExtraFields<Extra extends object> = Omit<Extra, keyof ComponentlessFormBoundaryNode | 'component'>;

export type FormBoundaryNode<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = ComponentlessFormBoundaryNode &
	FormBoundaryExtraFields<Extra> & {
		component: BindableComponent<ComponentlessFormBoundaryNode & FormBoundaryExtraFields<Extra>, C>;
	};

export type FormBoundaryComponentProps = ComponentlessFormBoundaryNode & { htmlId: string };

type ComponentlessFormViewNode = FormNodeBase & {
	kind: 'view';
};

type SimpleFormViewNode = ComponentlessFormViewNode & {
	component: AnyVueComponent;
};

type FormViewExtraFields<Extra extends object> = Omit<Extra, keyof ComponentlessFormViewNode | 'component'>;

export type FormViewNode<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = ComponentlessFormViewNode &
	FormViewExtraFields<Extra> & {
		component: BindableComponent<ComponentlessFormViewNode & FormViewExtraFields<Extra>, C>;
	};

export type FormViewComponentProps = ComponentlessFormViewNode & { htmlId: string };

type ComponentlessControllerlessFormFieldNode = FormNodeBase & {
	kind: 'field';
	variant?: FieldPresentation[];
	// controller: FieldController<string, any, any>;
};
type SimpleFormFieldNode = ComponentlessControllerlessFormFieldNode & {
	component: AnyVueComponent;
	controller: AnyFieldController;
};

type FormFieldExtraFields<Extra extends object> = Omit<Extra, keyof ComponentlessControllerlessFormFieldNode | 'component' | 'controller'>;

export type FormFieldNode<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent, State = any> = ComponentlessControllerlessFormFieldNode &
	FormFieldExtraFields<Extra> & {
		controller: FieldController<any, State, FormFieldExtraFields<Extra>>;
		component: BindableComponent<ComponentlessControllerlessFormFieldNode & FormFieldExtraFields<Extra>, C>;
	};

export type FormFieldComponentProps = ComponentlessControllerlessFormFieldNode & { htmlId: string };

// export type NewContainerNodeConfig<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = Omit<ContainerNodeBase, 'kind' | 'id' | 'children'> &
// 	ContainerExtraFields<Extra> & {
// 		component: BindableComponent<ContainerNodeBase & ContainerExtraFields<Extra>, C>;
// 	};
export type NewFormBoundaryNodeConfig<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = Omit<ComponentlessFormBoundaryNode, 'kind' | 'id' | 'children'> &
	FormBoundaryExtraFields<Extra> & {
		component: BindableComponent<ComponentlessFormBoundaryNode & FormBoundaryExtraFields<Extra>, C>;
	};
export type NewFormViewNodeConfig<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent> = Omit<ComponentlessFormViewNode, 'kind' | 'id'> &
	FormViewExtraFields<Extra> & {
		component: BindableComponent<ComponentlessFormViewNode & FormViewExtraFields<Extra>, C>;
	};
export type NewFormFieldNodeConfig<Extra extends object = object, C extends AnyVueComponent = AnyVueComponent, State = any> = Omit<ComponentlessControllerlessFormFieldNode, 'kind' | 'id'> &
	FormFieldExtraFields<Extra> & {
		controller: FieldController<any, State, FormFieldExtraFields<Extra>>;
		component: BindableComponent<ComponentlessControllerlessFormFieldNode & FormFieldExtraFields<Extra>, C>;
	};

export type FormContainerLikeNode = SimpleContainerNode | SimpleFormBoundaryNode;
export type FormChildNode = SimpleContainerNode | SimpleFormFieldNode | SimpleFormViewNode;
export type FormNode = FormContainerLikeNode | FormChildNode;

export type NodeKindMap = {
	container: ContainerNode;
	form: FormBoundaryNode;
	field: FormFieldNode;
	view: FormViewNode;
};
export type NodeKind = keyof NodeKindMap;

export function getVariantClassNames(node: { variant?: string | string[] | null }, prefix: string) {
	if (!node.variant) return [];
	const variants = Array.isArray(node.variant) ? node.variant : [node.variant];
	return variants.map(variant => `${prefix}--${variant}`);
}
