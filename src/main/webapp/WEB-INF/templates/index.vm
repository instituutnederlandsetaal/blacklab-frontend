<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        ## Preconnect to BlackLab server to reduce latency for API requests
        ## This establishes TCP/TLS connection early, speeding up both OPTIONS preflight and actual requests
        <link rel="preconnect" href="$BLS_URL_ON_CLIENT" crossorigin>

        <script>
            var WITH_CREDENTIALS = $esc.javascript($FRONTEND_WITH_CREDENTIALS);

            /** Base url of the blacklab-frontend. Guaranteed not to end in '/' */
            var CONTEXT_URL = "$esc.javascript($CF_URL_ON_CLIENT)";
            // Not suffixed with the corpus id
            var BLS_URL = "$esc.javascript($BLS_URL_ON_CLIENT)";

            var OIDC_AUTHORITY = "$esc.javascript($OIDC_AUTHORITY)";
            var OIDC_METADATA_URL = "$esc.javascript($OIDC_METADATA_URL)";
            var OIDC_CLIENT_ID = "$esc.javascript($OIDC_CLIENT_ID)";

            var DEBUG_INFO_VISIBLE = $debugInfo;
        </script>
    </head>
    <body>
        <div id="vue-root"></div>
        #if($VITE)
        <script type="module" src="$VITE/@vite/client"></script>
        <script type="module" src="$VITE/src/app/entrypoint/main.ts"></script>
        #else
        <script src="$CF_URL_ON_CLIENT/js/main.js?_$cache" onerror="document.body.insertAdjacentHTML('afterbegin', '<div class=\'alert alert-danger\'>Warning: Failed to load main.js from $CF_URL_ON_CLIENT/js/main.js. Please check your configuration.</div>');"></script>
        #end
    </body>

    <!-- Commit hash: $commitHash -->
    <!-- Commit time: $commitTime -->
    <!-- Commit message: $commitMessage -->
    <!-- Version: $version -->

</html>
